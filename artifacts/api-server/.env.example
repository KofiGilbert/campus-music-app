# Campus Music API — environment shape. Copy to .env (gitignored) and fill in.
# NEVER commit real secrets. In production these are set as Fly secrets
# (`fly secrets set ...`); in CI as GitHub Actions secrets.

# --- Core ---
PORT=8080
NODE_ENV=development
# Postgres (Supabase pooler). ?sslmode=no-verify since the pg Pool sets no ssl itself.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=no-verify
# JWT signing secret — REQUIRED in production (dev falls back to an insecure default).
JWT_SECRET=change-me
# CORS allow-list (comma-separated origins). Unset = permissive (dev only).
# e.g. https://admin.campus-music.app,https://campus-music.app
ALLOWED_ORIGINS=

# --- Cloudflare R2 (audio storage, S3-compatible API) ---
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=campus-music-audio
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Cloudflare API token (for wrangler / Cloudflare REST API; not the S3 keys above).
R2_API_TOKEN_VALUE=

# --- Deploy / CI only (NOT app runtime) ---
# Used by flyctl + CI to deploy; set as a GitHub Actions secret + local flyctl auth.
# Do not load this into the running server.
# FLY_API_TOKEN=

# --- Phases 1-2 (email + image storage + CDN) ---
RESEND_API_KEY=
EMAIL_FROM=Campus Music <no-reply@campus-music.app>
APP_BASE_URL=https://campus-music.app
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AUDIO_CDN_URL=
IMAGE_CDN_URL=

# --- Phase 5: Live Now (LiveKit Cloud) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://<project>.livekit.cloud

# --- Phase 6: push (Expo Push) ---
# Optional: raises Expo push rate limits / enables receipts.
EXPO_ACCESS_TOKEN=

# --- Phase 10.5: Campus Music TV (Cloudflare Stream) ---
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_CUSTOMER_SUBDOMAIN=customer-<id>.cloudflarestream.com

# --- Phase 11: observability (Sentry) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
