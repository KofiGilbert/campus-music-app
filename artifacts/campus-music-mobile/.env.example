# Campus Music mobile — local development env
# Copy this file to `.env` (gitignored) and adjust as needed.
#
# Full origin of the local API server. The app prepends this to every relative
# API path (e.g. `/api/tracks`). See constants/config.ts for resolution logic.
#
#   Web / iOS simulator : http://localhost:8080
#   Android emulator    : http://10.0.2.2:8080      (emulator alias for the host machine)
#   Physical device     : http://<your-LAN-IP>:8080 (e.g. http://192.168.1.50:8080)
#
EXPO_PUBLIC_API_URL=http://localhost:8080
