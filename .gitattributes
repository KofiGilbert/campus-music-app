# Normalize all text files to LF in the repository and the working tree.
# Keeps generated output (orval, drizzle-kit) from churning CRLF<->LF on Windows.
* text=auto eol=lf

# Known binaries — never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.svg   text eol=lf
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.mp3   binary
*.mp4   binary
*.mov   binary
*.pdf   binary
*.jks   binary
*.keystore binary
*.p8    binary
*.p12   binary

# Lockfiles: LF, and mark generated so they collapse in PR diffs.
pnpm-lock.yaml linguist-generated text eol=lf
